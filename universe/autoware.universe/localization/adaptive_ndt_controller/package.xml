<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adaptive_ndt_controller</name>
  <version>0.1.0</version>
  <description>
    Adaptive NDT Controller for EKF uncertainty-based parameter control.
    This package implements real-time NDT scan matcher parameter adaptation
    based on EKF localization uncertainty estimates.
  </description>
  <maintainer email="research@example.com">Research Project</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>autoware_localization_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
